<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core"  xmlns:form="sap.ui.layout.form"  >
	<Dialog contentWidth="500px" afterOpen="onDialogAfterOpen" afterClose="onDialogAfterClose($event,'AddComments')"  title="{i18n>xtit.AddComments}" titleAlignment="Center" showHeader="true" >
		<content>
			  <form:SimpleForm  layout="ResponsiveGridLayout" labelSpanXL="12"	labelSpanL="12" labelSpanM="12" labelSpanS="12"	columnsM="1" columnsL="1"  columnsXL="1"	singleContainerFullSize="false"  >
					<Label text="{i18n>xtit.Comments}"/>
                    <TextArea value="{oMainModel>/oDialogComments/sDescription}" ></TextArea>
            </form:SimpleForm>
		</content>
		<buttons>
            <Button type="Emphasized" tooltip="{i18n>xbut.Ok}" text="{i18n>xbut.Ok}" press="onPressAddDialogComments"/>
			<Button type="Ghost" tooltip="{i18n>xbut.Close}" text="{i18n>xbut.Close}" icon="sap-icon://cancel" press="onDialogClose($event, 'AddComments')"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>